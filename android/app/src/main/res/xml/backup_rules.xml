<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 ou anterior. O backup já está desligado (allowBackup=false); aqui tudo fica excluído de novo, por garantia:
     a credencial do motor é presa ao Keystore deste aparelho e não serviria em outro. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
